[Unit]
Description=Piano Timer v2 backend (API, admin, MIDI out)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__CODE_DIR__/backend
Environment=PIANO_DATA_DIR=__DATA_DIR__
Environment=PIANO_PORT=8080
# Environment=PIANO_ADMIN_TOKEN=change-me
# Environment=PIANO_MIDI_OUT=Digital Piano
ExecStart="__CODE_DIR__/backend/.venv/bin/uvicorn" app.main:app --host 0.0.0.0 --port 8080 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
