# User-level unit: installed to ~/.config/systemd/user/piano-kiosk.service by install.sh.
# Running in the user's graphical session means it inherits WAYLAND_DISPLAY / DISPLAY automatically,
# so it works on Bookworm's default Wayland (labwc/wayfire) and on X11 alike.
[Unit]
Description=Piano Timer v2 kiosk (Godot)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PIANO_API_BASE=http://127.0.0.1:8080
WorkingDirectory=__GODOT_DIR__
# Wait for the backend (max ~40 s) so the first screen isn't "offline"
ExecStartPre=/bin/bash -c 'for i in $(seq 1 40); do curl -fs http://127.0.0.1:8080/api/v1/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart="__GODOT_DIR__/piano-timer.arm64" --rendering-driver opengl3_es --fullscreen
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
